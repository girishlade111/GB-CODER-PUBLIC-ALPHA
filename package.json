{
  "name": "gb-coder",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:marketing": "npm --prefix apps/marketing run dev",
    "dev:ide": "vite",
    "dev:server": "cd server && node index.js",
    "dev:all": "concurrently --names \"SERVER,VITE\" --prefix-colors \"cyan,green\" \"cd server && node index.js\" \"vite\"",
    "build": "node scripts/build-unified.mjs",
    "build:ide": "vite build",
    "build:marketing": "npm --prefix apps/marketing run build",
    "verify:bundle": "node scripts/measure-initial-bundle.mjs --assert-absent",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify:deploy": "node scripts/verify-deploy-config.mjs",
    "audit:devserver": "node scripts/audit-devserver.mjs",
    "audit:tests": "node scripts/audit-run-tests.mjs",
    "audit:backup": "node scripts/backup-restore-tests.mjs",
    "audit:e2e:backup": "node scripts/e2e-backup-restore.mjs",
    "audit:webcontainer": "node scripts/webcontainer-regression-tests.mjs",
    "audit:lifecycle": "node scripts/dev-server-lifecycle-tests.mjs",
    "audit:npm": "node scripts/npm-install-performance-tests.mjs",
    "audit:preview": "node scripts/preview-refresh-tests.mjs",
    "audit:newtab": "node scripts/open-in-new-tab-tests.mjs",
    "audit:reload": "node scripts/reload-recovery-tests.mjs",
    "audit:status": "node scripts/runtime-status-tests.mjs",
    "audit:monaco": "node scripts/monaco-worker-tests.mjs",
    "audit:coep": "node scripts/coep-resource-tests.mjs",
    "audit:e2e": "node scripts/e2e-browser-test.mjs",
    "audit:coderabbit": "node scripts/coderabbit-audit.mjs",
    "preview": "vite preview",
    "preview:combined": "node scripts/preview-combined.mjs",
    "vercel-build": "node scripts/build-unified.mjs",
    "audit:editor-persistence": "node scripts/editor-persistence-tests.mjs",
    "audit:workspace-reliability": "node scripts/workspace-reliability-tests.mjs",
    "audit:workspace-coordination": "node scripts/workspace-coordination-tests.mjs",
    "audit:e2e:workspace-reliability": "node scripts/e2e-workspace-reliability.mjs",
    "audit:e2e:workspace-app": "node scripts/e2e-workspace-app.mjs",
    "audit:e2e:persistence": "node scripts/e2e-editor-persistence.mjs",
    "audit:integration": "node scripts/audit-integration.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:headers": "node scripts/audit-headers.mjs",
    "audit:pwa-migration": "node scripts/audit-pwa-migration.mjs",
    "audit:build-output": "node scripts/audit-build-output.mjs",
    "audit:e2e:phase1-1": "node scripts/e2e-phase1-1-validation.mjs",
    "audit:e2e:phase1-sync": "node scripts/e2e-phase1-sync-acceptance.mjs",
    "audit:workbench": "node scripts/verify-phase2-workbench.mjs",
    "audit:e2e:phase2-workbench": "node scripts/e2e-phase2-workbench.mjs",
    "audit:ai": "node scripts/verify-phase3a-assist.mjs",
    "audit:tools": "node scripts/verify-phase3b-tools.mjs",
    "audit:e2e:phase3b-tools": "node scripts/e2e-phase3b-tools-audit.mjs",
    "audit:agent": "node scripts/verify-phase3c-agent.mjs",
    "audit:e2e:phase3c-agent": "node scripts/e2e-phase3c-agent.mjs",
    "audit:e2e:migration": "node scripts/migration/e2e-migration-verification.mjs",
    "audit:assist:integration": "node scripts/verify-assist-provider-context.mjs",
    "audit:e2e:assist:integration": "node scripts/e2e-assist-provider-context.mjs",
    "audit:byok": "node scripts/verify-byok-provider-system.mjs",
    "audit:e2e:byok": "node scripts/e2e-byok-provider-system.mjs",
    "audit:security:byok": "node scripts/verify-byok-security-gate.mjs",
    "audit:ecosystem": "node scripts/verify-multi-provider-ecosystem.mjs",
    "audit:e2e:boot": "node scripts/e2e-boot-recovery.mjs",
    "audit:e2e:multi-provider": "node scripts/e2e-multi-provider-functional-acceptance.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@lmnr-ai/lmnr": "^0.8.40",
    "@monaco-editor/react": "^4.6.0",
    "@typescript/ata": "^0.9.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "@vue/compiler-sfc": "3.5.40",
    "@webcontainer/api": "^1.6.4",
    "axios": "^1.13.6",
    "diff": "^5.2.0",
    "e2b": "^2.37.0",
    "esbuild-wasm": "0.25.10",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "prettier": "^3.6.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-ga4": "^2.1.0",
    "react-hot-toast": "^2.6.0",
    "uuid": "^13.0.0",
    "vite-plugin-pwa": "^1.1.0",
    "web-vitals": "^5.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "astro": "^5.4.2",
    "@eslint/js": "^9.9.1",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
