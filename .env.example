# GB Coder Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Core AI (Build with AI, Explain, Fix, Optimize, Enhance)
# ============================================

# Choose provider: inception | atria | nvidia
AI_PROVIDER=inception

# Inception Labs (Mercury 2.5 - https://docs.inceptionlabs.ai)
INCEPTION_API_KEY=your_inception_api_key_here
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-2.5

# Atria ASI (Atria-Dawn-Preview - https://api.atria-asi.ai/docs)
ATRIA_API_KEY=your_atria_api_key_here
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL=Atria-Dawn-Preview

# NVIDIA NIM (Legacy option)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_MODEL=qwen/qwen3.5-397b-a17b

# ============================================
# Client-side AI Features
# ============================================

# Google Gemini API Key (Required for AI Chat Assistant)
# Get your key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server-side Gemini key for Screenshot to Code (api/vision-to-code.js).
# Optional: when unset the endpoint falls back to VITE_GEMINI_API_KEY from the
# request body, which is enough for local use but exposes the key in the
# browser bundle — set this for any real deployment.
GEMINI_API_KEY=your_gemini_api_key_here

# CodeRabbit AI API Key (Required for CodeRabbit Bug & Error Scanner)
# Get your key from: https://coderabbit.ai
VITE_CODERABBIT_API_KEY=your_coderabbit_api_key_here

# ============================================
# OPTIONAL: Feature Flags
# ============================================

# Enable/Disable AI suggestions
VITE_ENABLE_AI_SUGGESTIONS=true

# Enable/Disable external libraries manager
VITE_ENABLE_EXTERNAL_LIBRARIES=true

# ============================================
# OPTIONAL: Development
# ============================================

# Custom development port (default: 5173)
VITE_DEV_PORT=5173

# ============================================
# OPTIONAL: Analytics
# ============================================

# Google Analytics 4 Measurement ID
VITE_GA4_MEASUREMENT_ID=

# Vercel Analytics ID
VITE_VERCEL_ANALYTICS_ID=

# ============================================
# NOTES:
# ============================================
# - Never commit .env file with real values
# - .env is already in .gitignore
# - Only VITE_* variables are exposed to client
# - Restart dev server after changing .env
