# GB Coder Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Core AI (Build with AI, Explain, Fix, Optimize, Enhance)
# ============================================

# Choose provider: inception | atria | nvidia
AI_PROVIDER=inception

# Inception Labs (Mercury 2.5 - https://docs.inceptionlabs.ai)
INCEPTION_API_KEY=your_inception_api_key_here
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-2.5

# Atria ASI (Atria-Dawn-Preview - https://api.atria-asi.ai/docs)
ATRIA_API_KEY=your_atria_api_key_here
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL=Atria-Dawn-Preview

# NVIDIA NIM (Legacy option)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_MODEL=qwen/qwen3.5-397b-a17b

# ============================================
# Server-side AI & Serverless Function Credentials
# DO NOT prefix sensitive keys with VITE_ to prevent bundling into client assets
# Client-side AI operates strictly via Bring-Your-Own-Key (BYOK) configured in the UI
# ============================================

# Server-side Gemini key for Screenshot to Code (api/vision-to-code.js) and serverless AI proxy
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Supabase Authentication & GitHub OAuth (Phase 2)
# ============================================
# Public client configuration for Supabase Authentication.
# GB Coder operates local-first; if these are absent, the IDE functions seamlessly in Guest Mode.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY into VITE_ variables!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# Backward compatibility fallback if using legacy anon key:
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# OPTIONAL: Feature Flags
# ============================================

# Enable/Disable AI suggestions
VITE_ENABLE_AI_SUGGESTIONS=true

# Enable/Disable external libraries manager
VITE_ENABLE_EXTERNAL_LIBRARIES=true

# ============================================
# OPTIONAL: Development
# ============================================

# Custom development port (default: 5173)
VITE_DEV_PORT=5173

# ============================================
# OPTIONAL: Analytics
# ============================================

# Google Analytics 4 Measurement ID
VITE_GA4_MEASUREMENT_ID=

# Vercel Analytics ID
VITE_VERCEL_ANALYTICS_ID=

# ============================================
# NOTES:
# ============================================
# - Never commit .env file with real values
# - .env is already in .gitignore
# - Only VITE_* variables are exposed to client
# - Restart dev server after changing .env
