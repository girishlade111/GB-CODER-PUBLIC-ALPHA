+  } catch (err) {
+    record('PORT-B23-03', 'Project B legitimately starts on 5173 after confirmed A shutdown', 'FAIL', err.message);
+  }
+
+  // PORT-B23-04: Project A shutdown lacks a port-close event; B must not be permanently blocked.
