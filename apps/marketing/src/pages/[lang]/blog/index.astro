---
// GB Coder — Localized Blog Index Route (/[lang]/blog)
import BlogIndexPage from '../../../components/pages/BlogIndexPage.astro';
import { NON_DEFAULT_LANGUAGES } from '../../../i18n/languages';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
---

<BlogIndexPage lang={lang} />
