---
// GB Coder — Localized Contact Route (/[lang]/contact)
import ContactPage from '../../components/pages/ContactPage.astro';
import { NON_DEFAULT_LANGUAGES } from '../../i18n/languages';

export function getStaticPaths() {
  return NON_DEFAULT_LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
---

<ContactPage lang={lang} />
