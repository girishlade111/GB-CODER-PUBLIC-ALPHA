---
import '../styles/site.css';
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,follow"/><title>Page not found — GB Coder</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head>
<body><main class="not-found"><a class="home-brand" href="/">GB Coder / LadeStack</a><p class="error-code">404</p><h1>A little off the path.</h1><p>This page isn't here. Your next idea still can be.</p><div class="cta-row"><a class="cta-button" href="/">Back to home</a><a class="cta-button ui-button-outline" href="/sitemap">Explore all pages</a></div><a class="editor-link" href="/app/projects">Open the studio →</a></main></body></html>
<style>.not-found{width:min(100%,900px);margin:auto;padding:4rem 1.5rem}.home-brand{color:var(--text-primary);font-weight:700;text-decoration:none}.error-code{font-size:clamp(7rem,22vw,14rem);line-height:1;margin:4rem 0 2rem;color:var(--border);letter-spacing:-.04em}h1{font-size:clamp(2.5rem,7vw,4rem);margin-bottom:1rem}.not-found>p:not(.error-code){color:var(--text-secondary)}.editor-link{display:inline-block;color:var(--primary);margin-top:2rem;font-size:.9rem}</style>
