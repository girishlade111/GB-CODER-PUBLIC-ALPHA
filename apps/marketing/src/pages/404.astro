---
import '../styles/site.css';
import Icon from '../components/ui/Icon.astro';

// Astro emits /404.html. The static host serves it with a 404 status for
// unmatched URLs; do not rewrite unknown routes to this file with status 200.
const destinations = [
  { href: '/app/projects', title: 'Open the studio', description: 'Get back to building.' },
  { href: '/docs', title: 'Read the docs', description: 'Find your next step.' },
  { href: '/features', title: 'Explore features', description: 'See what you can make.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="This page could not be found. Head home or find your next step in GB Coder." />
    <title>Page not found (404) — GB Coder</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="error-header">
      <a class="error-brand" href="/" aria-label="GB Coder — home">
        <span class="error-brand__mark" aria-hidden="true">GB</span>
        <span><strong>GB Coder</strong><small>LadeStack</small></span>
      </a>
      <a class="text-link header-link" href="/app/projects">Open studio <Icon name="arrow-up-right" size={16} /></a>
    </header>

    <main id="main-content" tabindex="-1">
      <section class="error-hero" aria-labelledby="error-title">
        <div class="error-art reveal" aria-hidden="true">
          <div class="error-code"><span>4</span><span class="error-zero">0</span><span>4</span></div>
          <div class="route-thread"><span></span><Icon name="arrow-right" size={20} /></div>
        </div>
        <div class="error-copy">
          <h1 class="reveal" id="error-title">A little off the path.</h1>
          <p class="error-explanation reveal">We couldn’t find this page. Let’s get you back to building.</p>
          <div class="error-actions reveal">
            <a href="/" class="ui-button"><Icon name="arrow-left" size={17} />Back to home</a>
            <a href="/" class="ui-button ui-button-outline" id="go-back">Go back</a>
          </div>
          <p class="error-path reveal"><span>Page not found</span><span aria-hidden="true">/</span><code id="attempted-path">404</code></p>
        </div>
      </section>

      <nav class="destinations reveal" aria-labelledby="destinations-title">
        <h2 id="destinations-title">A few familiar places</h2>
        <ul>
          {destinations.map(({ href, title, description }) => (
            <li><a href={href}>
              <span><span class="destination-title">{title}</span><span class="destination-description">{description}</span></span>
              <Icon name="arrow-up-right" size={18} />
            </a></li>
          ))}
        </ul>
      </nav>
    </main>

    <footer class="error-footer">
      <span>GB Coder by LadeStack</span>
      <nav aria-label="Footer"><a class="text-link" href="/sitemap">All pages</a><a class="text-link" href="/contact">Contact</a></nav>
    </footer>

    <script>
      const path = document.getElementById('attempted-path');
      if (path) path.textContent = window.location.pathname;

      // Keep a working home fallback with JavaScript disabled, on direct visits,
      // or when the previous page belongs to another site.
      document.getElementById('go-back')?.addEventListener('click', (event) => {
        const referrer = document.referrer && new URL(document.referrer);
        if (window.history.length > 1 && referrer && referrer.origin === window.location.origin) {
          event.preventDefault();
          window.history.back();
        }
      });
    </script>
  </body>
</html>

<style>
  .error-header, .error-footer, main {
    width: min(100% - 3rem, 1120px);
    margin-inline: auto;
  }
  .error-header, .error-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .error-header { min-height: 90px; border-bottom: 1px solid var(--border-subtle); }
  .error-brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--text-primary); text-decoration: none; }
  .error-brand__mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: var(--text-primary); color: var(--surface); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.02em; }
  .error-brand strong, .error-brand small { display: block; }
  .error-brand strong { font-size: 0.88rem; line-height: 1.25; font-weight: 750; }
  .error-brand small { margin-top: 0.15rem; font-size: 0.7rem; line-height: 1.2; color: var(--text-secondary); }
  .text-link { display: inline-flex; align-items: center; gap: 0.45rem; position: relative; min-height: 44px; color: var(--text-secondary); font-size: 0.8rem; font-weight: 600; text-decoration: none; }
  .text-link::after { content: ''; position: absolute; inset: auto 0 8px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 200ms ease-out; }
  .text-link:hover::after { transform: scaleX(1); }
  main { display: flex; flex-direction: column; justify-content: center; padding-block: 2.5rem; }
  .error-hero { text-align: center; }
  .error-art { position: relative; width: fit-content; margin: 0 auto 1.75rem; }
  .error-code { display: flex; align-items: center; color: var(--text-faint); font-size: clamp(7rem, 22vw, 14rem); font-weight: 550; line-height: 1.05; letter-spacing: -0.04em; user-select: none; }
  .error-code > span { display: block; }
  .error-code > span:first-child { transform: rotate(-6deg); }
  .error-code > span:last-child { transform: rotate(6deg); }
  .error-zero { color: var(--primary); animation: zero-drift 8s ease-in-out infinite; }
  .route-thread { display: flex; align-items: center; gap: 0.5rem; position: absolute; width: 37%; bottom: 1%; left: 33%; color: var(--primary); transform: rotate(-6deg); }
  .route-thread span { flex: 1; height: 1px; background: var(--border); }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
  .error-explanation { max-width: 40rem; margin: 1rem auto 0; color: var(--text-secondary); font-size: 1rem; }
  .error-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .error-actions .ui-button { min-height: 48px; border-radius: var(--radius-sm); transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1); }
  .error-actions .ui-button:hover { transform: translateY(-3px); }
  .error-actions .ui-button:active { transform: translateY(0) scale(0.98); }
  .error-path { display: flex; align-items: baseline; justify-content: center; gap: 0.65rem; max-width: 32rem; margin: 1.25rem auto 0; color: var(--text-muted); font-size: 0.75rem; }
  .error-path > span { flex-shrink: 0; }
  .error-path code { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 0.75rem; }
  .destinations { width: min(100%, 800px); margin: 3.5rem auto 0; }
  .destinations h2 { margin-bottom: 1rem; font-size: 0.8rem; line-height: 1.4; letter-spacing: 0; font-weight: 600; color: var(--text-muted); }
  .destinations ul { display: grid; list-style: none; border-top: 1px solid var(--border); }
  .destinations li { min-width: 0; }
  .destinations li + li { border-top: 1px solid var(--border-subtle); }
  .destinations a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 80px; padding-block: 1rem; color: var(--text-primary); text-decoration: none; }
  .destination-title { display: block; font-size: 0.9rem; font-weight: 650; }
  .destination-description { display: block; margin-top: 0.25rem; font-size: 0.8rem; color: var(--text-secondary); }
  .destinations a :global(svg) { flex-shrink: 0; color: var(--primary); transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1); }
  .destinations a:hover :global(svg) { transform: translate(3px, -3px); }
  .destinations a:hover .destination-title { text-decoration: underline; text-underline-offset: 4px; }
  .error-footer { min-height: 80px; border-top: 1px solid var(--border-subtle); color: var(--text-muted); font-size: 0.75rem; }
  .error-footer nav { display: flex; gap: 1.5rem; }
  .reveal { animation: arrive 480ms cubic-bezier(0.16, 1, 0.3, 1) backwards; }
  h1.reveal { animation-delay: 70ms; }
  .error-explanation.reveal { animation-delay: 130ms; }
  .error-actions.reveal { animation-delay: 190ms; }
  .error-path.reveal { animation-delay: 230ms; }
  .destinations.reveal { animation-delay: 280ms; }
  @keyframes arrive { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes zero-drift { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-8px) rotate(3deg); } }
  @media (min-width: 640px) {
    .destinations ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .destinations li + li { border-top: 0; }
    .destinations li { padding-inline: 1.25rem; }
    .destinations li:first-child { padding-left: 0; }
    .destinations li:last-child { padding-right: 0; }
    .error-header, .error-footer, main { width: min(100% - 5rem, 1120px); }
  }
  @media (max-width: 389px) {
    .error-actions { flex-direction: column; }
    .error-footer { align-items: flex-start; flex-direction: column; justify-content: center; gap: 0; padding-block: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal, .error-zero { animation: none; }
    .error-actions .ui-button:hover, .error-actions .ui-button:active, .destinations a:hover :global(svg) { transform: none; }
  }
</style>
