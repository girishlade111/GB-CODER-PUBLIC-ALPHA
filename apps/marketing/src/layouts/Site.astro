---
// GB Coder — Unified Multilingual Marketing Layout (Astro)
// Warm cream, restrained terracotta/coral accents, Cormorant Garamond serif headings, Inter sans-serif body.
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from '../i18n/languages';

interface Props {
  title: string;
  description: string;
  lang?: string;
  basePath?: string;
  canonicalPath?: string; // For backward compatibility with existing tests/pages
  ogType?: 'website' | 'article';
  publishedDate?: string;
  author?: string;
  structuredData?: Record<string, unknown>[];
  isLegalPage?: boolean;
}

const {
  title,
  description,
  lang = DEFAULT_LANGUAGE,
  basePath: propBasePath,
  canonicalPath,
  ogType = 'website',
  publishedDate,
  author = 'Girish Lade',
  structuredData = [],
  isLegalPage = false,
} = Astro.props;

// Determine basePath: if canonicalPath is provided (e.g. '/about'), derive basePath ('about')
const basePath = propBasePath !== undefined
  ? propBasePath
  : (canonicalPath ? canonicalPath.replace(/^\/+|\/+$/g, '') : '');

const langMeta = SUPPORTED_LANGUAGES[lang] || SUPPORTED_LANGUAGES[DEFAULT_LANGUAGE];
---

<!doctype html>
<html lang={langMeta.htmlLang} dir={langMeta.dir}>
  <head>
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      basePath={basePath}
      ogType={ogType}
      publishedDate={publishedDate}
      author={author}
      structuredData={structuredData}
      isLegalPage={isLegalPage}
    />

    <style is:global>
      :root {
        --canvas: #faf9f5;
        --surface: #ffffff;
        --border: #e6dfd8;
        --border-subtle: #f0ebe4;
        --text-primary: #141413;
        --text-secondary: #5e5c56;
        --text-muted: #8e8b82;
        --accent-terracotta: #cc785c;
        --accent-hover: #b8654a;
        --accent-dark: #1f1e1d;
        --code-bg: #1e1e1e;
        --code-text: #d4d4d4;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--canvas);
        color: var(--text-primary);
        line-height: 1.6;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      /* Heading Typography */
      h1, h2, h3, h4 {
        color: var(--text-primary);
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      h1 {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 600;
      }

      h2 {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 600;
      }

      /* Hero Sections */
      .page-hero {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 1.5rem 2.5rem;
        text-align: center;
      }

      .page-hero h1 {
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        margin-bottom: 1rem;
      }

      .page-hero p {
        font-size: clamp(1rem, 2vw, 1.2rem);
        color: var(--text-secondary);
        max-width: 680px;
        margin: 0 auto;
      }

      .hero-tag {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent-terracotta);
        background: rgba(204, 120, 92, 0.1);
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        margin-bottom: 1.25rem;
      }

      /* Common Content Wrappers */
      .content-wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 2rem;
        margin-bottom: 1.5rem;
      }

      .card h2 {
        font-size: 1.75rem;
        margin-bottom: 1rem;
      }

      .card h3 {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 1.5rem 0 0.5rem;
      }

      .card p {
        color: var(--text-secondary);
        margin-bottom: 0.9rem;
      }

      .card ul {
        color: var(--text-secondary);
        padding-left: 1.5rem;
        margin-bottom: 0.9rem;
      }

      .card li {
        margin-bottom: 0.4rem;
      }

      .card a {
        color: var(--accent-terracotta);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .card strong {
        color: var(--text-primary);
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .mini-card {
        background: var(--canvas);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 1.5rem;
      }

      .mini-card h3 {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .mini-card p {
        font-size: 0.925rem;
        color: var(--text-secondary);
      }

      .cta-row {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin: 2.5rem 0 0;
      }

      .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--accent-terracotta);
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.65rem 1.25rem;
        border-radius: 6px;
        transition: background-color 0.2s, transform 0.1s;
      }

      .cta-button:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
      }

      .cta-button:active {
        transform: translateY(0);
      }

      /* Skip to content link for accessibility */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--accent-terracotta);
        color: white;
        padding: 8px;
        z-index: 1000;
        transition: top 0.2s;
        text-decoration: none;
        font-weight: 600;
        border-radius: 0 0 4px 0;
      }

      .skip-link:focus {
        top: 0;
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header lang={lang} basePath={basePath} isLegalPage={isLegalPage} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} basePath={basePath} isLegalPage={isLegalPage} />
  </body>
</html>
