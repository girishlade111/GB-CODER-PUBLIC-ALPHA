---
// GB Coder — Unified Multilingual Marketing Layout (Astro)
// Mineral-mint tokens and locally served Manrope typography.
import '../styles/site.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from '../i18n/languages';

interface Props {
  title: string;
  description: string;
  lang?: string;
  basePath?: string;
  canonicalPath?: string; // For backward compatibility with existing tests/pages
  ogType?: 'website' | 'article';
  publishedDate?: string;
  author?: string;
  structuredData?: Record<string, unknown>[];
  isLegalPage?: boolean;
}

const {
  title,
  description,
  lang = DEFAULT_LANGUAGE,
  basePath: propBasePath,
  canonicalPath,
  ogType = 'website',
  publishedDate,
  author = 'Girish Lade',
  structuredData = [],
  isLegalPage = false,
} = Astro.props;

// Determine basePath: if canonicalPath is provided (e.g. '/about'), derive basePath ('about')
const basePath = propBasePath !== undefined
  ? propBasePath
  : (canonicalPath ? canonicalPath.replace(/^\/+|\/+$/g, '') : '');

const langMeta = SUPPORTED_LANGUAGES[lang] || SUPPORTED_LANGUAGES[DEFAULT_LANGUAGE];
---

<!doctype html>
<html lang={langMeta.htmlLang} dir={langMeta.dir}>
  <head>
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      basePath={basePath}
      ogType={ogType}
      publishedDate={publishedDate}
      author={author}
      structuredData={structuredData}
      isLegalPage={isLegalPage}
    />


  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header lang={lang} basePath={basePath} isLegalPage={isLegalPage} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} basePath={basePath} isLegalPage={isLegalPage} />
  </body>
</html>
