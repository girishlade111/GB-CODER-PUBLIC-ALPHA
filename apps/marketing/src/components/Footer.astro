---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from '../i18n/languages';
import { getLocalizedPath } from '../i18n/utils';
import { getNav } from '../i18n/navigation';

interface Props {
  lang?: string;
  basePath?: string;
  isLegalPage?: boolean;
}

const { lang = DEFAULT_LANGUAGE, basePath = '', isLegalPage = false } = Astro.props;
const nav = getNav(lang);

// Compute links for current language
const homeUrl = getLocalizedPath(lang, '');
const featuresUrl = getLocalizedPath(lang, 'features');
const docsUrl = getLocalizedPath(lang, 'docs');
const blogUrl = getLocalizedPath(lang, 'blog');
const aboutUrl = getLocalizedPath(lang, 'about');
const contactUrl = getLocalizedPath(lang, 'contact');

// Legal links: strictly point to authoritative English canonical URLs
const privacyUrl = '/privacy-policy';
const termsUrl = '/terms-and-conditions';
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Positioning -->
      <div class="footer-col brand-col">
        <a href={homeUrl} class="footer-brand" aria-label="GB Coder Homepage">
          <div class="brand-badge">GB</div>
          <div class="brand-text">
            <span class="brand-title">GB Coder</span>
            <span class="brand-sub">LadeStack</span>
          </div>
        </a>
        <p class="brand-tagline">
          The browser-first web development studio. Instant prototyping, WebContainer full-stack runtime, and local-first data privacy.
        </p>
      </div>

      <!-- Col 2: Product Links -->
      <div class="footer-col">
        <h3 class="col-title">{nav.features}</h3>
        <ul class="footer-list">
          <li><a href={featuresUrl}>{nav.features}</a></li>
          <li><a href={docsUrl}>{nav.docs}</a></li>
          <li><a href={blogUrl}>{nav.blog}</a></li>
          <li><a href="/app/projects">{nav.app}</a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Connect -->
      <div class="footer-col">
        <h3 class="col-title">{nav.about}</h3>
        <ul class="footer-list">
          <li><a href={aboutUrl}>{nav.about}</a></li>
          <li><a href={contactUrl}>{nav.contact}</a></li>
          <li><a href="https://ladestack.in" target="_blank" rel="noopener noreferrer">LadeStack.in ↗</a></li>
          <li><a href="https://github.com/girishlade111" target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Governance -->
      <div class="footer-col">
        <h3 class="col-title">{nav.terms}</h3>
        <ul class="footer-list">
          <li><a href={privacyUrl}>{nav.privacy}</a></li>
          <li><a href={termsUrl}>{nav.terms}</a></li>
        </ul>
        <p class="legal-notice">{nav.legalNotice}</p>
      </div>
    </div>

    <!-- Multilingual Switcher Strip in Footer -->
    <div class="footer-lang-strip" aria-label="Select Language">
      <span class="lang-strip-label">{nav.languageSelectLabel}:</span>
      <ul class="lang-strip-links">
        {Object.entries(SUPPORTED_LANGUAGES).map(([code, meta]) => {
          const targetUrl = isLegalPage ? getLocalizedPath(code, '') : getLocalizedPath(code, basePath);
          const isCurrent = code === lang;
          return (
            <li>
              <a
                href={targetUrl}
                class:list={['lang-strip-link', { active: isCurrent }]}
                aria-current={isCurrent ? 'true' : undefined}
              >
                {meta.nativeName}
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>{nav.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--canvas);
    padding: 4rem 1.5rem 2.5rem;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .brand-col {
    max-width: 360px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .brand-badge {
    width: 32px;
    height: 32px;
    background: var(--accent-terracotta);
    color: #ffffff;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .brand-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .brand-tagline {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .col-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-list a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  .footer-list a:hover {
    color: var(--text-primary);
  }

  .legal-notice {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-top: 0.75rem;
  }

  .footer-lang-strip {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 0;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .lang-strip-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lang-strip-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
  }

  .lang-strip-link {
    font-size: 0.825rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .lang-strip-link:hover {
    color: var(--text-primary);
  }

  .lang-strip-link.active {
    color: var(--accent-terracotta);
    font-weight: 600;
  }

  .footer-bottom {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.825rem;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
