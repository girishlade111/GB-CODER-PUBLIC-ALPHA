---
/**
 * GB Coder — technology marquee.
 * Adapted from Aceternity UI's marquee composition, but static: the chips
 * sit in a centred rail that wraps, so nothing scrolls on its own and no
 * item is ever hidden.
 */
interface Props {
  items: string[];
  label?: string;
}

const { items, label } = Astro.props;
---

<div class="marquee" role="group" aria-label={label}>
  <div class="marquee__track">
    <div class="marquee__group">
      {items.map((item) => (
        <span class="marquee__chip">{item}</span>
      ))}
    </div>
  </div>
</div>
