---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CodeBlock from '../CodeBlock.astro';
import Icon from '../ui/Icon.astro';
import { getBlogContent, getAllArticleSlugs } from '../../i18n/blog';
import { getNav } from '../../i18n/navigation';
import { getLocalizedPath, getCanonicalUrl, calculateReadingTime } from '../../i18n/utils';

interface Props {
  lang?: string;
  slug: string;
}

const { lang = 'en', slug } = Astro.props;
const blogContent = getBlogContent(lang);
const nav = getNav(lang);
const article = blogContent.articles[slug];

if (!article) {
  throw new Error(`Article not found for slug: ${slug} in lang: ${lang}`);
}

const basePath = `blog/${slug}`;
const blogIndexUrl = getLocalizedPath(lang, 'blog');

// Calculate reading time
const totalText = `${article.intro} ${article.sections.map(s => `${s.heading} ${s.body}`).join(' ')}`;
const readMinutes = calculateReadingTime(totalText, lang);

// Breadcrumb items & JSON-LD
const breadcrumbItems = [
  { label: nav.blog, path: 'blog' },
  { label: article.title },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: nav.home,
      item: getCanonicalUrl(lang, ''),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nav.blog,
      item: getCanonicalUrl(lang, 'blog'),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.title,
      item: getCanonicalUrl(lang, basePath),
    },
  ],
};

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  dateModified: article.date,
  author: {
    '@type': 'Person',
    name: article.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'GB Coder by LadeStack',
    url: 'https://code.ladestack.in',
  },
  mainEntityOfPage: getCanonicalUrl(lang, basePath),
};

// Other related articles
const otherSlugs = getAllArticleSlugs().filter((s) => s !== slug);
---

<Site
  title={`${article.title} | GB Coder Blog`}
  description={article.description}
  lang={lang}
  basePath={basePath}
  ogType="article"
  publishedDate={article.date}
  author={article.author}
  structuredData={[breadcrumbJsonLd, blogPostingJsonLd]}
>
  <Breadcrumbs items={breadcrumbItems} lang={lang} />

  <article class="post-shell">
    <header class="post-head">
      <div class="post-tags">
        {article.tags.map((tag) => (
          <span class="post-tag">{tag}</span>
        ))}
      </div>

      <h1 class="post-title">{article.title}</h1>

      <div class="post-meta">
        <span class="post-meta__author">{article.author}</span>
        <span class="post-meta__sep" aria-hidden="true">/</span>
        <time datetime={article.date}>{article.date}</time>
        <span class="post-meta__sep" aria-hidden="true">/</span>
        <span>{readMinutes} {nav.readingTimeSuffix}</span>
      </div>
    </header>

    <div class="post-layout">
      <div class="post-body">
        <p class="post-lead">{article.intro}</p>

        {article.sections.map((section, index) => (
          <section class="post-section">
            <div class="post-section__head">
              <span class="post-section__index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2>{section.heading}</h2>
            </div>
            <p>{section.body}</p>
            {section.codeSnippet && (
              <CodeBlock
                locale={lang}
                code={section.codeSnippet}
                lang={section.codeLang || 'text'}
              />
            )}
          </section>
        ))}

        <aside class="post-next" aria-label={article.relatedDocsLabel}>
          <span class="post-next__label">Docs</span>
          <a href={getLocalizedPath(lang, article.relatedDocsLink)} class="post-next__link">
            <span>{article.relatedDocsLabel}</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </aside>
      </div>

      <aside class="post-rail" aria-label={blogContent.relatedArticlesTitle}>
        <div class="post-rail__inner">
          <h2 class="post-rail__title">{blogContent.relatedArticlesTitle}</h2>
          <ul class="post-rail__list">
            {otherSlugs.map((otherSlug) => {
              const otherArticle = blogContent.articles[otherSlug];
              if (!otherArticle) return null;
              const otherUrl = getLocalizedPath(lang, `blog/${otherSlug}`);
              return (
                <li>
                  <a href={otherUrl} class="post-rail__item">
                    <span class="post-rail__item-title">{otherArticle.title}</span>
                    <span class="post-rail__item-link">
                      {blogContent.readArticleLabel}
                      <Icon name="arrow-up-right" size={12} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </aside>
    </div>

    <footer class="post-foot">
      <a href={blogIndexUrl} class="post-back">
        <Icon name="arrow-left" size={14} />
        <span>{blogContent.backToBlogLabel}</span>
      </a>
      <a href="/app/projects" class="post-cta">
        <span>{nav.startCoding}</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </footer>
  </article>
</Site>

<style>
  .post-shell {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(2.5rem, 5vw, 4rem) 1.5rem 6rem;
  }

  /* --- Masthead --------------------------------------------------------- */
  .post-head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .post-tag {
    font-size: 0.7rem;
    font-weight: 650;
    background: var(--surface-soft);
    color: var(--primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .post-title {
    font-size: clamp(2.1rem, 4.6vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    max-width: 24ch;
    margin: 0 0 1.5rem;
    color: var(--text-primary);
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: 0.83rem;
    color: var(--text-muted);
  }
  .post-meta__author {
    color: var(--text-primary);
    font-weight: 500;
  }
  .post-meta__sep {
    color: var(--border);
  }

  /* --- Body + rail ------------------------------------------------------ */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .post-body {
    min-width: 0;
    padding-top: 2.5rem;
  }

  .post-lead {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 3rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 2px solid var(--primary);
    max-width: 60ch;
  }

  .post-section {
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .post-section:last-of-type {
    border-bottom: 0;
    margin-bottom: 1rem;
  }
  .post-section__head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 1rem;
  }
  .post-section__index {
    font: 11px/1 ui-monospace, SFMono-Regular, Consolas, monospace;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }
  .post-section h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--text-primary);
  }
  .post-section p {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0 0 1rem;
    max-width: 60ch;
  }

  /* --- Docs hand-off ---------------------------------------------------- */
  .post-next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.35rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .post-next__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .post-next__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--primary);
    font-weight: 650;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .post-next__link:hover {
    color: var(--accent-hover);
  }

  /* --- Related rail ----------------------------------------------------- */
  .post-rail__inner {
    position: sticky;
    top: 5.5rem;
    padding-top: 2.5rem;
  }
  .post-rail__title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
    margin: 0;
  }
  .post-rail__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-rail__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
  }
  .post-rail__item-title {
    font-size: 0.95rem;
    font-weight: 550;
    line-height: 1.35;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }
  .post-rail__item:hover .post-rail__item-title {
    color: var(--primary);
  }
  .post-rail__item-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .post-rail__item:hover .post-rail__item-link {
    color: var(--primary);
  }

  /* --- Footer ----------------------------------------------------------- */
  .post-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .post-back:hover {
    color: var(--text-primary);
  }
  .post-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
    font-weight: 650;
    font-size: 0.88rem;
    padding: 0.6rem 1.1rem;
    border-radius: 9999px;
    transition: background 0.18s ease;
  }
  .post-cta:hover {
    background: var(--accent-hover);
  }

  @media (max-width: 960px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-rail__inner {
      position: static;
      padding-top: 0;
      margin-top: 3rem;
    }
  }

  @media (max-width: 640px) {
    .post-shell {
      padding-inline: 1.25rem;
    }
    .post-title {
      font-size: 2.1rem;
    }
    .post-section p {
      font-size: 0.98rem;
    }
  }
</style>
