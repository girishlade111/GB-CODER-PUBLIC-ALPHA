---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { getBlogContent, getAllArticleSlugs } from '../../i18n/blog';
import { getNav } from '../../i18n/navigation';
import { getLocalizedPath, getCanonicalUrl, calculateReadingTime } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const content = getBlogContent(lang);
const nav = getNav(lang);
const articleSlugs = getAllArticleSlugs();

const breadcrumbItems = [
  { label: nav.blog, path: 'blog' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: nav.home,
      item: getCanonicalUrl(lang, ''),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nav.blog,
      item: getCanonicalUrl(lang, 'blog'),
    },
  ],
};
---

<Site
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  basePath="blog"
  structuredData={[breadcrumbJsonLd]}
>
  <Breadcrumbs items={breadcrumbItems} lang={lang} />

  <section class="page-hero">
    <span class="hero-tag">{content.heroTag}</span>
    <h1>{content.heroTitle}</h1>
    <p>{content.heroDescription}</p>
  </section>

  <div class="blog-index-container">
    <div class="article-grid">
      {articleSlugs.map((slug) => {
        const article = content.articles[slug];
        if (!article) return null;
        const articleUrl = getLocalizedPath(lang, `blog/${slug}`);

        // Compute reading time from all section text
        const totalText = `${article.intro} ${article.sections.map(s => `${s.heading} ${s.body}`).join(' ')}`;
        const readMinutes = calculateReadingTime(totalText, lang);

        return (
          <article class="article-card">
            <div class="article-card-header">
              <div class="article-tags">
                {article.tags.map((tag) => (
                  <span class="article-tag">{tag}</span>
                ))}
              </div>
              <span class="article-reading-time">
                {readMinutes} {nav.readingTimeSuffix}
              </span>
            </div>

            <h2 class="article-card-title">
              <a href={articleUrl}>{article.title}</a>
            </h2>

            <p class="article-card-desc">{article.description}</p>

            <div class="article-card-footer">
              <div class="article-author-meta">
                <span class="author-name">{article.author}</span>
                <span class="dot-sep">&bull;</span>
                <time datetime={article.date}>{article.date}</time>
              </div>
              <a href={articleUrl} class="read-more-link">
                {content.readArticleLabel} &rarr;
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Site>

<style>
  .blog-index-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .article-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .article-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 2.25rem;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .article-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .article-tag {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--canvas);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    color: var(--text-secondary);
  }

  .article-reading-time {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .article-card-title {
    font-size: 1.65rem;
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .article-card-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .article-card-title a:hover {
    color: var(--accent-terracotta);
  }

  .article-card-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .article-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .article-author-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .author-name {
    color: var(--text-primary);
    font-weight: 500;
  }

  .dot-sep {
    font-size: 0.8rem;
  }

  .read-more-link {
    color: var(--accent-terracotta);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.15s;
  }

  .read-more-link:hover {
    color: var(--accent-hover);
  }
</style>
