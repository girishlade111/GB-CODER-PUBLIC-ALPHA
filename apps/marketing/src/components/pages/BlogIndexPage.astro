---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon from '../ui/Icon.astro';
import { getBlogContent, getAllArticleSlugs } from '../../i18n/blog';
import { getNav } from '../../i18n/navigation';
import { getUi } from '../../i18n/ui';
import { getLocalizedPath, getCanonicalUrl, calculateReadingTime } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const content = getBlogContent(lang);
const nav = getNav(lang);
const ui = getUi(lang);
const articleSlugs = getAllArticleSlugs();

const breadcrumbItems = [
  { label: nav.blog, path: 'blog' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: nav.home,
      item: getCanonicalUrl(lang, ''),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nav.blog,
      item: getCanonicalUrl(lang, 'blog'),
    },
  ],
};

// Reading time is computed from the full article body so the index matches
// what the reader actually spends on the page.
const articles = articleSlugs
  .map((slug) => {
    const article = content.articles[slug];
    if (!article) return null;
    const totalText = `${article.intro} ${article.sections.map((s) => `${s.heading} ${s.body}`).join(' ')}`;
    return {
      slug,
      article,
      url: getLocalizedPath(lang, `blog/${slug}`),
      readMinutes: calculateReadingTime(totalText, lang),
    };
  })
  .filter(Boolean)
  .sort((a, b) => (a.article.date < b.article.date ? 1 : -1));

const [featured, ...rest] = articles;

// Only the most-used tags become filters, so the control stays a quick
// refinement rather than a second taxonomy to read.
const tagCounts = new Map<string, number>();
for (const entry of articles) {
  for (const tag of entry.article.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8)
  .map(([tag]) => tag);
---

<Site
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  basePath="blog"
  structuredData={[breadcrumbJsonLd]}
>
  <Breadcrumbs items={breadcrumbItems} lang={lang} />

  <section class="page-hero blog-hero">
    <h1>{content.heroTitle}</h1>
    <p>{content.heroDescription}</p>
  </section>

  {featured && (
    <section class="blog-index-container">
      <!-- Featured guide -->
      <article class="featured-article">
        <div class="featured-article__meta">
          <span class="featured-article__label">{ui.featuredArticle}</span>
          <div class="article-tags">
            {featured.article.tags.map((tag) => (
              <span class="article-tag">{tag}</span>
            ))}
          </div>
        </div>
        <div class="featured-article__body">
          <h2>
            <a href={featured.url}>{featured.article.title}</a>
          </h2>
          <p>{featured.article.description}</p>
          <div class="featured-article__foot">
            <span class="article-author-meta">
              <span class="author-name">{featured.article.author}</span>
              <span class="dot-sep">&bull;</span>
              <time datetime={featured.article.date}>{featured.article.date}</time>
              <span class="dot-sep">&bull;</span>
              <span>{featured.readMinutes} {nav.readingTimeSuffix}</span>
            </span>
            <a href={featured.url} class="read-more-link">
              <span>{content.readArticleLabel}</span>
              <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        </div>
      </article>

      <!-- Tag filter -->
      <div class="blog-filter" role="group" aria-label={nav.blog}>
        <button type="button" class="blog-filter__chip" data-filter="" aria-pressed="true">
          {ui.filterAll}
        </button>
        {tags.map((tag) => (
          <button type="button" class="blog-filter__chip" data-filter={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>

      <!-- Article index -->
      <div class="article-grid" data-article-grid>
        {rest.map((entry) => (
          <article class="article-card" data-tags={entry.article.tags.join('|').toLowerCase()}>
            <div class="article-card-header">
              <div class="article-tags">
                {entry.article.tags.map((tag) => (
                  <span class="article-tag">{tag}</span>
                ))}
              </div>
              <span class="article-reading-time">
                {entry.readMinutes} {nav.readingTimeSuffix}
              </span>
            </div>

            <h2 class="article-card-title">
              <a href={entry.url}>{entry.article.title}</a>
            </h2>

            <p class="article-card-desc">{entry.article.description}</p>

            <div class="article-card-footer">
              <div class="article-author-meta">
                <span class="author-name">{entry.article.author}</span>
                <span class="dot-sep">&bull;</span>
                <time datetime={entry.article.date}>{entry.article.date}</time>
              </div>
              <a href={entry.url} class="read-more-link">
                <span>{content.readArticleLabel}</span>
                <Icon name="arrow-right" size={14} />
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="blog-empty" data-blog-empty hidden>{content.heroDescription}</p>
    </section>
  )}
</Site>

<script>
  // Client-side tag filter. Filters are progressive enhancement: every
  // article stays in the document and reachable without JavaScript.
  const grid = document.querySelector<HTMLElement>('[data-article-grid]');
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const wanted = (chip.dataset.filter ?? '').toLowerCase();
      chips.forEach((other) => {
        other.setAttribute('aria-pressed', other === chip ? 'true' : 'false');
      });
      let visible = 0;
      grid?.querySelectorAll<HTMLElement>('[data-tags]').forEach((card) => {
        const tags = (card.dataset.tags ?? '').split('|');
        const show = !wanted || tags.some((tag) => tag.trim() === wanted);
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style>
  .blog-hero {
    max-width: 1200px;
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 6rem) 1.5rem 2.5rem;
  }
  .blog-hero h1 {
    font-size: clamp(2.5rem, 5.5vw, 4.75rem);
    max-width: 18ch;
    margin-bottom: 1.25rem;
  }
  .blog-hero p {
    color: var(--text-secondary);
    font-size: 1.12rem;
    max-width: 62ch;
    margin: 0;
    line-height: 1.65;
  }

  .blog-index-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }

  /* --- Featured guide -------------------------------------------------- */
  .featured-article {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .featured-article__meta {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .featured-article__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .featured-article__body h2 {
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-bottom: 0.9rem;
    max-width: 24ch;
  }
  .featured-article__body h2 a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .featured-article__body h2 a:hover {
    color: var(--primary);
  }
  .featured-article__body > p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 64ch;
  }
  .featured-article__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* --- Tag filter ------------------------------------------------------ */
  .blog-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .blog-filter__chip {
    font: inherit;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 0.32rem 0.8rem;
    min-height: 34px;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .blog-filter__chip:hover {
    background: var(--surface-soft);
    color: var(--text-primary);
  }
  .blog-filter__chip[aria-pressed='true'] {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  /* --- Article rows ---------------------------------------------------- */
  .article-grid {
    display: grid;
  }
  .article-card {
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .article-card[hidden] {
    display: none;
  }
  .article-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .article-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .article-tag {
    font-size: 0.7rem;
    font-weight: 650;
    background: var(--surface-soft);
    color: var(--primary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .article-reading-time {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .article-card-title {
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 0.7rem;
    max-width: 30ch;
  }
  .article-card-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .article-card-title a:hover {
    color: var(--primary);
  }
  .article-card-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 1.25rem;
    max-width: 70ch;
  }
  .article-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .article-author-meta {
    font-size: 0.83rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .author-name {
    color: var(--text-primary);
    font-weight: 500;
  }
  .dot-sep {
    font-size: 0.8rem;
  }
  .read-more-link {
    color: var(--primary);
    font-weight: 650;
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .read-more-link:hover {
    color: var(--accent-hover);
  }
  .blog-empty {
    padding: 2.5rem 0;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .featured-article {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 700px) {
    .blog-hero {
      padding: 2.5rem 1.25rem 2rem;
    }
    .blog-hero h1 {
      font-size: 2.5rem;
    }
    .blog-index-container {
      padding-inline: 1.25rem;
    }
  }
</style>
