---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { getContactContent } from '../../i18n/contact';
import { getNav } from '../../i18n/navigation';
import { getCanonicalUrl } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const content = getContactContent(lang);
const nav = getNav(lang);

const breadcrumbItems = [
  { label: nav.contact, path: 'contact' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: nav.home,
      item: getCanonicalUrl(lang, ''),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nav.contact,
      item: getCanonicalUrl(lang, 'contact'),
    },
  ],
};
---

<Site
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  basePath="contact"
  structuredData={[breadcrumbJsonLd]}
>
  <Breadcrumbs items={breadcrumbItems} lang={lang} />

  <section class="page-hero">
    <span class="hero-tag">{content.heroTag}</span>
    <h1>{content.heroTitle}</h1>
    <p>{content.heroDescription}</p>
  </section>

  <div class="content-wrap">
    <div class="card">
      <h2>{content.cardDirectTitle}</h2>
      <ul>
        <li>
          <strong>{content.emailLabel}</strong>{' '}
          <a href="mailto:girishlade111@gmail.com">girishlade111@gmail.com</a>
        </li>
        <li>
          <strong>{content.locationLabel}</strong> {content.locationValue}
        </li>
      </ul>
      <p class="direct-note">{content.noteDirectEmail}</p>
    </div>

    <div class="card">
      <h2>{content.socialTitle}</h2>
      <div class="grid-2">
        <div class="mini-card">
          <h3>Instagram</h3>
          <p><a href="https://www.instagram.com/girish_lade_/" target="_blank" rel="noopener noreferrer">@girish_lade_</a></p>
        </div>
        <div class="mini-card">
          <h3>LinkedIn</h3>
          <p><a href="https://www.linkedin.com/in/girish-lade-075bba201/" target="_blank" rel="noopener noreferrer">Girish Lade</a></p>
        </div>
        <div class="mini-card">
          <h3>GitHub</h3>
          <p><a href="https://github.com/girishlade111" target="_blank" rel="noopener noreferrer">@girishlade111</a></p>
        </div>
        <div class="mini-card">
          <h3>CodePen</h3>
          <p><a href="https://codepen.io/Girish-Lade-the-looper" target="_blank" rel="noopener noreferrer">@Girish-Lade-the-looper</a></p>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>{content.aboutCreatorTitle}</h2>
      <p>{content.aboutCreatorText}</p>
      <div class="cta-row">
        <a href="/app/projects" class="cta-button">{content.startCodingBtn}</a>
      </div>
    </div>
  </div>
</Site>

<style>
  .direct-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1rem;
    font-style: italic;
  }
</style>
