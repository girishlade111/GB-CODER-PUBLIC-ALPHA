---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { getFeaturesContent } from '../../i18n/features';
import { getNav } from '../../i18n/navigation';
import { getCanonicalUrl } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const content = getFeaturesContent(lang);
const nav = getNav(lang);

const breadcrumbItems = [
  { label: nav.features, path: 'features' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: nav.home,
      item: getCanonicalUrl(lang, ''),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nav.features,
      item: getCanonicalUrl(lang, 'features'),
    },
  ],
};
---

<Site
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  basePath="features"
  structuredData={[breadcrumbJsonLd]}
>
  <Breadcrumbs items={breadcrumbItems} lang={lang} />

  <section class="page-hero">
    <span class="hero-tag">{content.heroTag}</span>
    <h1>{content.heroTitle}</h1>
    <p>{content.heroDescription}</p>
    <div class="cta-row">
      <a href="/app/projects" class="cta-button">{content.ctaBtn}</a>
    </div>
  </section>

  <div class="features-container">
    <div class="section-heading">
      <h2>{content.groupsHeading}</h2>
      <p>{content.groupsSub}</p>
    </div>

    <div class="features-matrix">
      {content.items.map((item) => (
        <article class="feature-detail-card" id={item.id}>
          <div class="card-top">
            <span class="feature-badge">{item.badge}</span>
            <h2>{item.title}</h2>
          </div>
          <p class="feature-summary">{item.summary}</p>
          <ul class="feature-bullets">
            {item.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <section class="features-cta-banner">
      <h2>{content.ctaHeading}</h2>
      <p>{content.ctaSub}</p>
      <div class="cta-row">
        <a href="/app/projects" class="cta-button cta-lg">{content.ctaBtn}</a>
      </div>
    </section>
  </div>
</Site>

<style>
  .features-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-heading h2 {
    font-size: 2.25rem;
    margin-bottom: 0.5rem;
  }

  .section-heading p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .features-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .feature-detail-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .feature-detail-card:hover {
    transform: translateY(-2px);
    border-color: var(--border);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
  }

  .card-top {
    margin-bottom: 1rem;
  }

  .feature-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    background: rgba(204, 120, 92, 0.1);
    color: var(--accent-terracotta);
    margin-bottom: 0.75rem;
  }

  .feature-detail-card h2 {
    font-size: 1.45rem;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .feature-summary {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .feature-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
    margin-top: auto;
  }

  .feature-bullets li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.45;
  }

  .feature-bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent-terracotta);
    font-weight: 700;
  }

  .features-cta-banner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 3.5rem 2rem;
    text-align: center;
  }

  .features-cta-banner h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .features-cta-banner p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .cta-lg {
    padding: 0.85rem 2.25rem;
    font-size: 1.05rem;
  }
</style>
