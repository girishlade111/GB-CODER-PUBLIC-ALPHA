---
import Site from '../../layouts/Site.astro';
import AssistShowcase from '../AssistShowcase.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon from '../ui/Icon.astro';
import EnvironmentSwitch from '../visuals/EnvironmentSwitch.astro';
import StudioFrame from '../visuals/StudioFrame.astro';
import { getFeaturesContent } from '../../i18n/features';
import { getNav } from '../../i18n/navigation';
import { getUi } from '../../i18n/ui';
import { getCanonicalUrl } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const content = getFeaturesContent(lang);
const nav = getNav(lang);
const ui = getUi(lang);

const breadcrumbItems = [
  { label: nav.features, path: 'features' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: nav.home,
      item: getCanonicalUrl(lang, ''),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nav.features,
      item: getCanonicalUrl(lang, 'features'),
    },
  ],
};

// Capabilities are grouped by the job they do in the workspace, so the page
// reads as an architecture rather than a list of unrelated features.
const groupDefs = [
  {
    key: 'editor',
    title: ui.groupEditor,
    sub: ui.groupEditorSub,
    ids: ['code-editor', 'static-prototyping'],
  },
  {
    key: 'runtime',
    title: ui.groupRuntime,
    sub: ui.groupRuntimeSub,
    ids: ['webcontainer-runtime', 'live-preview'],
  },
  {
    key: 'framework',
    title: ui.groupFramework,
    sub: ui.groupFrameworkSub,
    ids: ['templates-frameworks', 'productivity-search'],
  },
  {
    key: 'data',
    title: ui.groupData,
    sub: ui.groupDataSub,
    ids: ['local-persistence', 'backup-restore'],
  },
];

const featureIcons: Record<string, string> = {
  'code-editor': 'code',
  'static-prototyping': 'layout',
  'webcontainer-runtime': 'terminal',
  'live-preview': 'monitor',
  'templates-frameworks': 'layers',
  'productivity-search': 'search',
  'local-persistence': 'database',
  'backup-restore': 'download',
};

const byId = new Map(content.items.map((item) => [item.id, item]));
const groups = groupDefs
  .map((group) => ({
    ...group,
    items: group.ids.map((id) => byId.get(id)).filter(Boolean),
  }))
  .filter((group) => group.items.length > 0);
---

<Site
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  basePath="features"
  structuredData={[breadcrumbJsonLd]}
>
  <Breadcrumbs items={breadcrumbItems} lang={lang} />

  <section class="page-hero features-hero canvas-backdrop">
    <h1>{content.heroTitle}</h1>
    <p>{content.heroDescription}</p>
    <div class="cta-row">
      <a href="/app/projects" class="cta-button">
        {content.ctaBtn}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- The two real editing environments -->
  <section class="feature-env section-container">
    <div class="section-intro">
      <div>
        <h2>{ui.envStatic} / {ui.envContainer}</h2>
      </div>
    </div>
    <EnvironmentSwitch staticLabel={ui.envStatic} containerLabel={ui.envContainer} />
  </section>

  <!-- Grouped architecture -->
  <section class="architecture">
    {groups.map((group, groupIndex) => (
      <div class="architecture-group">
        <div class="architecture-rail">
          <span class="architecture-rail__index" aria-hidden="true">
            {String(groupIndex + 1).padStart(2, '0')}
          </span>
          <h2>{group.title}</h2>
          <p>{group.sub}</p>
        </div>

        <div class="architecture-items">
          {group.items.map((item) => (
            <article class="capability-row" id={item.id}>
              <span class="capability-row__icon" aria-hidden="true">
                <Icon name={featureIcons[item.id] ?? 'sparkles'} size={20} />
              </span>
              <div class="capability-row__body">
                <span class="capability-row__badge">{item.badge}</span>
                <h3>{item.title}</h3>
                <p class="capability-row__summary">{item.summary}</p>
                <ul class="capability-row__bullets">
                  {item.bullets.map((bullet) => (
                    <li>
                      <Icon name="check" size={13} />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- The workspace these capabilities run inside -->
  <section class="feature-workspace">
    <div class="section-container">
      <div class="section-intro">
        <div>
          <h2>{ui.insideStudio.replace(/[.。！!]+$/, '')}</h2>
          <p class="section-sub">{ui.insideStudioSub}</p>
        </div>
      </div>
      <StudioFrame path="workspace / react-starter" fileName="App.jsx" />
    </div>
  </section>

  <div class="features-container">
    <AssistShowcase lang={lang} />
    <section class="features-cta-banner">
      <h2>{content.ctaHeading}</h2>
      <p>{content.ctaSub}</p>
      <div class="cta-row">
        <a href="/app/projects" class="cta-button">
          {content.ctaBtn}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </section>
  </div>
</Site>

<style>
  .section-container {
    max-width: 1248px;
    padding-inline: 1.5rem;
    margin-inline: auto;
  }
  .section-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }
  .section-intro > div {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .section-intro h2 {
    font-size: clamp(1.75rem, 2.8vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 24ch;
  }
  .section-sub {
    max-width: 56ch;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.65;
    margin: 0;
  }

  /* --- Hero ----------------------------------------------------------- */
  .features-hero {
    max-width: 1248px;
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 6rem) 1.5rem 3.5rem;
  }
  .features-hero .eyebrow {
    margin-bottom: 1.25rem;
  }
  .features-hero h1 {
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    max-width: 16ch;
    margin-bottom: 1.5rem;
  }
  .features-hero p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 62ch;
    margin: 0 0 2rem;
    line-height: 1.65;
  }

  /* --- Environment switch --------------------------------------------- */
  .feature-env {
    padding-block: 1rem 6rem;
  }

  /* --- Grouped architecture ------------------------------------------- */
  .architecture {
    max-width: 1248px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .architecture-group {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 3.5rem;
    padding-block: 4.5rem;
    border-top: 1px solid var(--border);
  }
  .architecture-rail {
    position: sticky;
    top: 7rem;
    align-self: start;
  }
  .architecture-rail__index {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--primary);
    margin-bottom: 0.9rem;
  }
  .architecture-rail h2 {
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }
  .architecture-rail p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
    max-width: 32ch;
  }
  .architecture-items {
    display: grid;
    gap: 2.75rem;
  }
  .capability-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 1.5rem;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid var(--border-subtle);
    scroll-margin-top: 110px;
  }
  .capability-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .capability-row__icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .capability-row__badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
  .capability-row__body h3 {
    font-size: clamp(1.2rem, 1.9vw, 1.5rem);
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin-bottom: 0.7rem;
  }
  .capability-row__summary {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 1.25rem;
    max-width: 62ch;
  }
  .capability-row__bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 64ch;
  }
  .capability-row__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .capability-row__bullets svg {
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  /* --- Workspace band ------------------------------------------------- */
  .feature-workspace {
    padding-block: 6.5rem;
    background: var(--surface);
    border-block: 1px solid var(--border-subtle);
  }

  /* --- Closing -------------------------------------------------------- */
  .features-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }
  .features-cta-banner {
    background: var(--surface-soft);
    border-radius: var(--radius-lg);
    padding: 3.25rem;
    margin-top: 3rem;
  }
  .features-cta-banner h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }
  .features-cta-banner p {
    color: var(--text-secondary);
    font-size: 1.02rem;
    margin: 0;
    max-width: 52ch;
  }
  .features-cta-banner .cta-row {
    margin-top: 1.75rem;
  }

  @media (max-width: 1000px) {
    .architecture-group {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
      padding-block: 3.5rem;
    }
    .architecture-rail {
      position: static;
    }
    .architecture-rail p {
      max-width: 60ch;
    }
  }

  @media (max-width: 700px) {
    .features-hero {
      padding: 2.5rem 1.25rem 2rem;
    }
    .features-hero h1 {
      font-size: 2.35rem;
    }
    .architecture {
      padding-inline: 1.25rem;
    }
    .capability-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .features-container {
      padding: 3.5rem 1.25rem;
    }
    .features-cta-banner {
      padding: 1.75rem;
    }
  }
</style>
