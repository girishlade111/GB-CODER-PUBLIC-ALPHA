---
import Site from '../../layouts/Site.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CodeBlock from '../CodeBlock.astro';
import Icon from '../ui/Icon.astro';
import { getDocsContent } from '../../i18n/docs';
import { getNav } from '../../i18n/navigation';
import { getCanonicalUrl } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const content = getDocsContent(lang);
const nav = getNav(lang);

const breadcrumbItems = [
  { label: nav.docs, path: 'docs' },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: nav.home,
      item: getCanonicalUrl(lang, ''),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nav.docs,
      item: getCanonicalUrl(lang, 'docs'),
    },
  ],
};
---

<Site
  title={content.metaTitle}
  description={content.metaDescription}
  lang={lang}
  basePath="docs"
  structuredData={[breadcrumbJsonLd]}
>
  <Breadcrumbs items={breadcrumbItems} lang={lang} />

  <section class="page-hero">
    <h1>{content.heroTitle}</h1>
    <p>{content.heroDescription}</p>
  </section>

  <div class="docs-layout-container">
    <!-- Sticky Table of Contents Sidebar -->
    <aside class="docs-sidebar" aria-label="Documentation Table of Contents">
      <div class="sidebar-sticky">
        <h2 class="toc-title">{content.tableOfContentsTitle}</h2>
        <nav class="toc-nav">
          <ol class="toc-list">
            {content.sections.map((section, index) => (
              <li>
                <a href={`#${section.id}`} class="toc-link">
                  <span class="toc-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span>{section.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </aside>

    <!-- Main Documentation Content -->
    <article class="docs-main-content">
      {content.sections.map((section) => (
        <section class="doc-section" id={section.id}>
          <div class="section-title-wrap">
            <h2>{section.title}</h2>
            <p class="section-desc">{section.description}</p>
          </div>

          <div class="subsections-list">
            {section.subsections.map((sub) => (
              <div class="doc-subsection">
                <h3>{sub.title}</h3>
                <p class="doc-text">{sub.content}</p>
                {sub.codeSnippet && (
                  <CodeBlock
                    locale={lang}
                    code={sub.codeSnippet}
                    lang={sub.codeLang || 'text'}
                  />
                )}
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="docs-footer-cta">
        <div>
          <h2>{content.ctaHeading}</h2>
          <p>{content.ctaSub}</p>
        </div>
        <a href="/app/projects" class="cta-button">
          <span>{content.ctaBtn}</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </section>
    </article>
  </div>
</Site>

<style>
  .docs-layout-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* --- Table of contents ------------------------------------------------ */
  .docs-sidebar {
    position: relative;
  }

  .sidebar-sticky {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    padding-inline-end: 0.5rem;
  }

  .toc-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.9rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.55rem 0;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
    border-bottom: 1px solid var(--border-subtle);
    transition: color 0.15s ease;
  }

  .toc-index {
    font: 10px/1 ui-monospace, SFMono-Regular, Consolas, monospace;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .toc-link:hover {
    color: var(--primary);
  }

  /* --- Main content ----------------------------------------------------- */
  .docs-main-content {
    min-width: 0;
  }

  .doc-section {
    margin-bottom: 4rem;
    scroll-margin-top: 6rem;
  }

  .section-title-wrap {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-title-wrap h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 68ch;
    margin: 0;
  }

  .subsections-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .doc-subsection h3 {
    font-size: 1.15rem;
    letter-spacing: -0.015em;
    margin: 0 0 0.6rem;
    color: var(--text-primary);
  }

  .doc-text {
    color: var(--text-secondary);
    font-size: 0.975rem;
    line-height: 1.7;
    max-width: 72ch;
    margin: 0;
  }

  /* --- Closing CTA ------------------------------------------------------ */
  .docs-footer-cta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 0;
    margin-top: 4rem;
  }

  .docs-footer-cta h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    letter-spacing: -0.025em;
    margin: 0 0 0.4rem;
  }

  .docs-footer-cta p {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 54ch;
    margin: 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .docs-layout-container {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .sidebar-sticky {
      position: static;
      max-height: none;
      padding-inline-end: 0;
    }

    .toc-list {
      flex-flow: row wrap;
      gap: 0.5rem;
    }

    .toc-link {
      border-bottom: 0;
      border: 1px solid var(--border);
      border-radius: 9999px;
      padding: 0.3rem 0.8rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 640px) {
    .docs-layout-container {
      padding-inline: 1.25rem;
    }
    .doc-section {
      margin-bottom: 3rem;
    }
  }
</style>
