---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from "../i18n/languages";
import { getLocalizedPath } from "../i18n/utils";
import { getNav } from "../i18n/navigation";
import Icon from "./ui/Icon.astro";

interface Props {
	lang?: string;
	basePath?: string;
	isLegalPage?: boolean;
}

const {
	lang = DEFAULT_LANGUAGE,
	basePath = "",
	isLegalPage = false,
} = Astro.props;
const nav = getNav(lang);
const currentLangMeta =
	SUPPORTED_LANGUAGES[lang] || SUPPORTED_LANGUAGES[DEFAULT_LANGUAGE];

// Compute links for current language
const homeUrl = getLocalizedPath(lang, "");
const featuresUrl = getLocalizedPath(lang, "features");
const docsUrl = getLocalizedPath(lang, "docs");
const blogUrl = getLocalizedPath(lang, "blog");
const aboutUrl = getLocalizedPath(lang, "about");
const contactUrl = getLocalizedPath(lang, "contact");

// Normalize basePath for active link styling
const cleanBase = basePath.replace(/^\/+|\/+$/g, "");
const isFeatures = cleanBase === "features";
const isDocs = cleanBase.startsWith("docs");
const isBlog = cleanBase.startsWith("blog");
const isAbout = cleanBase === "about";
const isContact = cleanBase === "contact";

const links = [
	{ href: featuresUrl, label: nav.features, active: isFeatures },
	{ href: docsUrl, label: nav.docs, active: isDocs },
	{ href: blogUrl, label: nav.blog, active: isBlog },
	{ href: aboutUrl, label: nav.about, active: isAbout },
	{ href: contactUrl, label: nav.contact, active: isContact },
];
---

<header class="site-header">
  <div class="nav-container">
    <a href={homeUrl} class="brand" aria-label="GB Coder — home">
      <span class="brand-badge" aria-hidden="true">
        <img src="/apple-touch-icon.png" alt="" class="brand-badge-img" width="34" height="34" />
      </span>
      <span class="brand-text">
        <span class="brand-title">GB Coder</span>
        <span class="brand-sub">LadeStack</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-links">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { active: link.active }]}
              aria-current={link.active ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <!-- Zero-JS language disclosure; closes on outside click / Escape -->
      <details class="lang-dropdown">
        <summary class="lang-summary" aria-label={nav.languageSelectLabel}>
          <span class="lang-code">{currentLangMeta.code.toUpperCase()}</span>
          <Icon name="chevron-down" size={12} />
        </summary>
        <div class="lang-panel">
          <p class="lang-panel-label">{nav.languageSelectLabel}</p>
          <ul class="lang-menu">
            {Object.entries(SUPPORTED_LANGUAGES).map(([code, meta]) => {
              const targetUrl = isLegalPage ? getLocalizedPath(code, '') : getLocalizedPath(code, basePath);
              const isCurrent = code === lang;
              return (
                <li>
                  <a
                    href={targetUrl}
                    class:list={['lang-item', { active: isCurrent }]}
                    aria-current={isCurrent ? 'true' : undefined}
                  >
                    <span class="lang-native">{meta.nativeName}</span>
                    <span class="lang-tag">{code.toUpperCase()}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </details>

      <a href="/app/projects" class="header-cta" id="headerCta">
        <span>{nav.startCoding}</span>
        <Icon name="arrow-right" size={14} />
      </a>

      <!-- Mobile menu: disclosure pattern keeps navigation usable without JS -->
      <details class="mobile-menu-disclosure">
        <summary class="mobile-menu-btn" aria-label={nav.mobileMenuToggle}>
          <Icon name="menu" size={18} />
        </summary>
        <div class="mobile-drawer">
          <nav aria-label="Mobile">
            <ul class="mobile-nav-links">
              <li><a href={homeUrl} class="mobile-nav-link">{nav.home} <Icon name="arrow-up-right" size={14} /></a></li>
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={['mobile-nav-link', { active: link.active }]}
                    aria-current={link.active ? 'page' : undefined}
                  >
                    {link.label} <Icon name="arrow-up-right" size={14} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="mobile-drawer-footer">
            <a href="/app/projects" class="header-cta mobile-cta">
              {nav.startCoding}
              <Icon name="arrow-right" size={14} />
            </a>
            <p class="mobile-note">Client-side runtime · local-first storage</p>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const disclosures = document.querySelectorAll<HTMLDetailsElement>(
    '.lang-dropdown, .mobile-menu-disclosure',
  );
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    disclosures.forEach((details) => {
      if (details.open && !details.contains(target)) details.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    let closed = false;
    disclosures.forEach((details) => {
      if (details.open) {
        details.open = false;
        closed = true;
      }
    });
    if (closed) (document.activeElement as HTMLElement | null)?.blur();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--background) 86%, transparent);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }
  .nav-container {
    max-width: 1248px;
    margin-inline: auto;
    min-height: 68px;
    padding: 0.65rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-badge {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: transparent;
    overflow: hidden;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .brand-badge-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius);
    display: block;
  }
  .brand:hover .brand-badge {
    transform: translateY(-1px) scale(1.05);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-title {
    font-size: 0.98rem;
    font-weight: 750;
    letter-spacing: -0.035em;
  }
  .brand-sub {
    margin-top: 0.22rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline-start: 50%;
    bottom: 3px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--primary);
    transform: translateX(-50%) scale(0);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--primary);
  }
  .nav-link.active::after {
    transform: translateX(-50%) scale(1);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .lang-dropdown {
    position: relative;
  }
  .lang-summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 36px;
    padding: 0.3rem 0.55rem;
    list-style: none;
    cursor: pointer;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .lang-summary::-webkit-details-marker,
  .mobile-menu-btn::-webkit-details-marker {
    display: none;
  }
  .lang-summary:hover {
    background: var(--surface);
    border-color: var(--border);
    color: var(--text-primary);
  }
  .lang-code {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .lang-summary svg {
    opacity: 0.65;
    transition: transform 0.2s ease;
  }
  .lang-dropdown[open] .lang-summary svg {
    transform: rotate(180deg);
  }
  .lang-panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 10px);
    width: 232px;
    padding: 0.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    z-index: 120;
  }
  .lang-panel-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0.35rem 0.6rem 0.45rem;
    margin: 0;
  }
  .lang-menu {
    list-style: none;
    display: grid;
    gap: 1px;
  }
  .lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 36px;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 0.82rem;
    text-decoration: none;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .lang-item:hover,
  .lang-item.active {
    background: var(--surface-soft);
    color: var(--primary);
  }
  .lang-item.active {
    font-weight: 650;
  }
  .lang-tag {
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    min-height: 36px;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .header-cta svg {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .header-cta:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }
  .header-cta:hover svg {
    transform: translateX(2px);
  }
  .mobile-menu-disclosure {
    display: none;
  }
  .mobile-menu-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    list-style: none;
    cursor: pointer;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    color: var(--text-primary);
    transition: background 0.15s ease;
  }
  .mobile-menu-btn:hover {
    background: var(--surface);
  }
  .mobile-drawer {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    background: var(--canvas);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    padding: 0.5rem 1.5rem 1.5rem;
    max-height: calc(100vh - 68px);
    overflow-y: auto;
  }
  .mobile-nav-links {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--border-subtle);
  }
  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .mobile-nav-link svg {
    color: var(--text-muted);
  }
  .mobile-nav-link.active,
  .mobile-nav-link:hover {
    color: var(--primary);
  }
  .mobile-drawer-footer {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.35rem;
  }
  .mobile-cta {
    width: 100%;
    min-height: 44px;
    font-size: 0.86rem;
  }
  .mobile-note {
    color: var(--text-muted);
    font-size: 0.72rem;
    text-align: center;
    margin: 0;
  }
  @media (max-width: 1000px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-disclosure {
      display: block;
    }
  }
  @media (max-width: 700px) {
    .nav-container {
      padding: 0.55rem 1rem;
      min-height: 62px;
    }
    .header-cta:not(.mobile-cta) {
      display: none;
    }
    .brand-sub {
      display: none;
    }
    .brand-badge {
      width: 32px;
      height: 32px;
    }
    .mobile-drawer {
      inset-inline: 0;
      padding-inline: 1.1rem;
    }
  }
</style>
